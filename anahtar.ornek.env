# ISTEGE BAGLI: Uygulama soru konusunu internet ve anahtar olmadan, kendi icinde bulur.
# Asagidaki anahtar sadece "zor/belirsiz" sorularda yedek olarak devreye girer.
# Kullanmak icin bu dosyanin kopyasini "anahtar.env" adiyla kaydedin ve # isaretini silin.

# Google Gemini (ucretsiz anahtar: https://aistudio.google.com/apikey)
#GEMINI_API_KEY=buraya_anahtarinizi_yapistirin

# Claude (https://console.anthropic.com)
#ANTHROPIC_API_KEY=buraya_anahtarinizi_yapistirin
